# LineageRCA local settings. No secrets in this project. Never commit this file's sibling .env (it is in .gitignore).
RUN_MODE=synthetic
SEED=42
LOG_LEVEL=INFO
LOG_DIR=logs
OUTPUT_DIR=outputs
RESULTS_DIR=results

# Delta warehouse: keep it OUTSIDE OneDrive. The folder name must end with lineagerca_warehouse.
# Regenerated on every run. Environment variables such as %USERPROFILE% are expanded by the code.
WAREHOUSE_DIR=%USERPROFILE%\lineagerca_warehouse

# Pipeline size (defaults live in configs/pipeline.yaml; values here win if set)
ORDERS_PER_DAY=2000
HEALTHY_DAYS=10

# Monitor / replay (defaults live in configs/monitor.yaml and configs/replay.yaml; values here win if set)
MONITOR_REL_THRESHOLD=0.15
REPLAY_REPEATS=3
PARTIAL_MIN_REDUCTION=0.5
INSTABILITY_TOLERANCE=0.02

# STRETCH only (not needed for the demo)
MARQUEZ_URL=http://localhost:5000
ICEBERG_CATALOG_DIR=%USERPROFILE%\lineagerca_warehouse\iceberg_catalog
